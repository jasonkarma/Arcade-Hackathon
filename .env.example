# Arcade AI (physical commerce) — https://platform.arcade.ai
# Server-side only. Never prefix these with NEXT_PUBLIC_.
ARCADE_API_KEY=""
ARCADE_API_BASE_URL="https://platform.arcade.ai"
ARCADE_USER_AGENT="memento/1.0"

# Total budget for one request, covering the LLM call plus the whole Arcade pipeline.
# Measured end to end: 49-55s (pattern 24s, product 12-18s, preview + checkout ~1s each),
# so keep headroom above that. Must stay under the route's maxDuration.
PIPELINE_BUDGET_MS=90000
ARCADE_REQUEST_TIMEOUT_MS=30000
ARCADE_POLL_INTERVAL_MS=2500

# Arcade category + selections. Discovered via POST /v1/categories/list and /v1/categories/get.
# 0ef267de-... = "Decorative Pillows".
ARCADE_PILLOW_CATEGORY_ID="0ef267de-f8c2-4a93-89a3-63be809f68e2"
ARCADE_PILLOW_FABRIC="canvas"
ARCADE_PILLOW_SIZE="18x18"
ARCADE_PILLOW_EMBELLISHMENT="none"
ARCADE_PILLOW_INSERT="none"

# true     = never call Arcade (offline UI work)
# fallback = call Arcade, show a mock product if it fails or runs long (safe for a live demo)
# false    = strict, surface real errors (use while integrating)
ARCADE_MOCK="fallback"

# Image-prompt LLM (any OpenAI-compatible chat completions endpoint)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_TIMEOUT_MS=30000
